{
	"luci-app-filescodebox": {
		"description": "Grant access to FilesCodeBox service page",
		"read": {
			"ubus": {
				"luci": ["getInitList"],
				"service": ["list"]
			},
			"uci": ["^filescodebox$"]
		},
		"write": {
			"ubus": {
				"file": ["exec"]
			},
			"file": {
				"/etc/init.d/filescodebox": ["exec"]
			}
		}
	}
}
